  mov qword ptr [PosFuncStateList+11],rbx
End_AutoGetMyselfObjIsDisable:
  cmp byte ptr [PosFuncStateList+23],FF
  je End_RecordCurrentCoordinatesForCustomCoordinatesTP
  cmp byte ptr [PosFuncStateList+23],00                  //Judge the value range n &gt;= 0
  jl End_RecordCurrentCoordinatesForCustomCoordinatesTP
  cmp byte ptr [PosFuncStateList+23],07                  //Judge the value range n &lt;= 7
  ja End_RecordCurrentCoordinatesForCustomCoordinatesTP
  push rdx
  push rdi
  push rcx
  xor rcx,rcx
  xor rdi,rdi
  xor rdx,rdx

  mov rdx,qword ptr [PosFuncStateList+11]  //Myself entity object pointer
  mov ecx,dword ptr [rdx+E0]               //Read coorfinate-x
  mov rdi,qword ptr [PosFuncStateList+1B]  //Pointer to custom coordinate TP config list
  xor rdx,rdx
  movzx edx,byte ptr [PosFuncStateList+23] //TP hotkey
  imul edx,0D
  add rdi,edx
  add rdi,01
  mov dword ptr [rdi],ecx                  //Record coorfinate-x

  mov rdx,qword ptr [PosFuncStateList+11]  //Myself entity object pointer
  mov ecx,dword ptr [rdx+E4]               //Read coorfinate-y
  mov rdi,qword ptr [PosFuncStateList+1B]  //Pointer to custom coordinate TP config list
  xor rdx,rdx
  movzx edx,byte ptr [PosFuncStateList+23] //TP hotkey
  imul edx,0D
  add rdi,edx
  add rdi,05
  mov dword ptr [rdi],ecx                  //Record coorfinate-y

  mov rdx,qword ptr [PosFuncStateList+11]  //Myself entity object pointer
  mov ecx,dword ptr [rdx+E8]               //Read coorfinate-z
  mov rdi,qword ptr [PosFuncStateList+1B]  //Pointer to custom coordinate TP config list
  xor rdx,rdx
  movzx edx,byte ptr [PosFuncStateList+23] //TP hotkey
  imul edx,0D
  add rdi,edx
  add rdi,09
  mov dword ptr [rdi],ecx                  //Record coorfinate-z

  pop rcx
  pop rdi
  pop rdx
  mov byte ptr [PosFuncStateList+23],FF
End_RecordCurrentCoordinatesForCustomCoordinatesTP:
  cmp byte ptr [PosFuncStateList+23],FF
  je End_RecordCurrentCoordinatesForSpringboardTP
  cmp byte ptr [PosFuncStateList+23],08                     //Judge the value range n &gt;= 8
  jl End_RecordCurrentCoordinatesForSpringboardTP
  cmp byte ptr [PosFuncStateList+23],09                     //Judge the value range n &lt;= 9
  ja End_RecordCurrentCoordinatesForSpringboardTP

  push rdi
  push rax
  push rcx
  xor rcx,rcx
  xor rax,rax
  xor rdi,rdi

  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer.
  mov ecx,dword ptr [rdi+E0]                     //Read coorfinate-x
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+24]        //Read springboard TP config list pointer.
  movzx eax,byte ptr [PosFuncStateList+23]       //TP hotkey
  sub eax,08
  imul eax,0C
  add rdi,eax
  mov dword ptr [rdi],ecx                        //Record coorfinate-x

  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer.
  mov ecx,dword ptr [rdi+E4]                     //Read coorfinate-y
  xor rdi,rdi
  mov rdi,[PosFuncStateList+24]                  //Read springboard TP config list pointer.
  movzx eax,byte ptr [PosFuncStateList+23]       //TP hotkey
  sub eax,08
  imul eax,0C
  add rdi,eax
  mov dword ptr [rdi+04],ecx                     //Record coorfinate-y

  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer.
  mov ecx,dword ptr [rdi+E8]                     //Read coorfinate-z
  xor rdi,rdi
  mov rdi,[PosFuncStateList+24]                  //Read springboard TP config list pointer.
  movzx eax,byte ptr [PosFuncStateList+23]       //TP hotkey
  sub eax,08
  imul eax,0C
  add rdi,eax
  mov dword ptr [rdi+08],ecx                     //Record coorfinate-z

  pop rcx
  pop rax
  pop rdi
  mov byte ptr [PosFuncStateList+23],FF
End_RecordCurrentCoordinatesForSpringboardTP:
  cmp byte ptr [PosFuncStateList+19],00          //Judge TP switch
  je End_AllTpLogic
  cmp byte ptr [PosFuncStateList+19],01          //Judge TP mode of custom coordinate TP
  je CustomCoordinateTP
  cmp byte ptr [PosFuncStateList+19],02          //Judge TP mode of map station TP
  je MapStationTp
  cmp byte ptr [PosFuncStateList+19],03          //Judge TP mode of spring TP
  je SpringTP
  jmp End_AllTpLogic
CustomCoordinateTP:
  cmp byte ptr [PosFuncStateList+1A],FF          //Judge TP state is wait TP
  je End_AllTpLogic
  cmp byte ptr [PosFuncStateList+1A],00          //Judge the value &gt;= 0
  jl End_AllTpLogic
  cmp byte ptr [PosFuncStateList+1A],07          //Judge the value &lt;= 7
  ja End_AllTpLogic

  push rdi
  push rcx
  xor rdi,rdi
  xor rcx,rcx
  mov rdi,qword ptr [PosFuncStateList+1B]        //Read custom coordinate TP config list pointer
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read TP hotkey
  imul ecx,0D
  add rdi,ecx
  cmp byte ptr [rdi],00                          //Judge the TP hotkey is disable
  pop rcx
  pop rdi
  je End_AllTpLogic

  push rdi
  push rax
  xor rax,rax
  xor rdi,rdi

  mov rdi,qword ptr [PosFuncStateList+1B]        //Read custom coordinate TP config list pointer
  movzx eax,byte ptr [PosFuncStateList+1A]       //Read TP hotkey
  imul eax,0D
  add eax,01                                     //Offset of part coordinate
  add eax,00                                     //Offset of x
  add rdi,eax                                    //Pointer to x
  xor rax,rax
  mov eax,dword ptr [rdi]                        //Read coordinate-x
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+50],eax                     //Write coordinate-x to myself entity coordinate of sever sync
  mov dword ptr [rdi+E0],eax                     //Write coordinate-x to myself entity coordinate
  xor rdi,rdi
  xor eax,eax

  mov rdi,qword ptr [PosFuncStateList+1B]        //Read custom coordinate TP config list pointer
  movzx eax,byte ptr [PosFuncStateList+1A]       //Read TP hotkey
  imul eax,0D
  add eax,01                                     //Offset of part coordinate
  add eax,04                                     //Offset of y
  add rdi,eax                                    //Pointer to y
  xor rax,rax
  mov eax,dword ptr [rdi]                        //Read coordinate-y
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+54],eax                     //Write coordinate-y to myself entity coordinate of sever sync
  mov dword ptr [rdi+E4],eax                     //Write coordinate-y to myself entity coordinate
  xor rdi,rdi
  xor eax,eax

  mov rdi,qword ptr [PosFuncStateList+1B]        //Read custom coordinate TP config list pointer
  movzx eax,byte ptr [PosFuncStateList+1A]       //Read TP hotkey
  imul eax,0D
  add eax,01                                     //Offset of part coordinate
  add eax,08                                     //Offset of z
  add rdi,eax                                    //Pointer to z
  xor rax,rax
  mov eax,dword ptr [rdi]                        //Read coordinate-z
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+58],eax                     //Write coordinate-z to myself entity coordinate of sever sync
  mov dword ptr [rdi+E8],eax                     //Write coordinate-z to myself entity coordinate

  pop rax
  pop rdi

  jmp End_AllTpLogic
MapStationTp:
  cmp byte ptr [PosFuncStateList+1A],FF          //Judge TP state is wait TP
  je End_AllTpLogic
  cmp byte ptr [PosFuncStateList+1A],00          //Judge the value &gt;= 0
  jl End_AllTpLogic
  cmp byte ptr [PosFuncStateList+1A],07          //Judge the value &lt;= 7
  ja End_AllTpLogic

  push rdi
  push rcx
  push rax
  xor rax,rax
  xor rcx,rcx
  xor rdi,rdi

  mov rdi,qword ptr [PosFuncStateList+0]         //Read map station TP coordinate array pointer
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read hotkey
  movzx eax,byte ptr [PosFuncStateList+2C]       //Read map select
  imul eax,08
  imul eax,0D                                    //Offset of map select
  imul ecx,0D                                    //Offset of map station
  add eax,ecx
  add rdi,eax
  cmp byte ptr [rdi],00                          //Judge the map station is disable
  pop rax
  pop rcx
  pop rdi
  je End_AllTpLogic

  push rdi
  push rcx
  xor rcx,rcx
  xor rdi,rdi

  mov rdi,qword ptr [PosFuncStateList+0]         //Read map station TP coordinate array pointer
  movzx ecx,byte ptr [PosFuncStateList+2C]       //Read map select
  imul ecx,08
  imul ecx,0D
  add rdi,ecx                                    //Pointer to map select
  xor rcx,rcx
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read hotkey
  imul ecx,0D
  add rdi,ecx
  add rdi,01                                     //Pointer to coordinate-x of map station coordinate array
  xor rcx,rcx
  mov ecx,dword ptr [rdi]                        //Read coordinate-x
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+50],ecx                     //Write coordinate-x for myself entity sever sync
  mov dword ptr [rdi+E0],ecx                     //Write coordinate-x for myself entity
  xor rdi,rdi
  xor rcx,rcx

  mov rdi,qword ptr [PosFuncStateList+0]         //Read map station TP coordinate array pointer
  movzx ecx,byte ptr [PosFuncStateList+2C]       //Read map select
  imul ecx,08
  imul ecx,0D
  add rdi,ecx                                    //Pointer to map select
  xor rcx,rcx
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read hotkey
  imul ecx,0D
  add rdi,ecx
  add rdi,05                                     //Pointer to coordinate-y of map station coordinate array
  xor rcx,rcx
  mov ecx,dword ptr [rdi]                        //Read coordinate-y
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+54],ecx                     //Write coordinate-y for myself entity sever sync
  mov dword ptr [rdi+E4],ecx                     //Write coordinate-y for myself entity
  xor rdi,rdi
  xor rcx,rcx

  mov rdi,qword ptr [PosFuncStateList+0]         //Read map station TP coordinate array pointer
  movzx ecx,byte ptr [PosFuncStateList+2C]       //Read map select
  imul ecx,08
  imul ecx,0D
  add rdi,ecx                                    //Pointer to map select
  xor rcx,rcx
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read hotkey
  imul ecx,0D
  add rdi,ecx
  add rdi,09                                     //Pointer to coordinate-z of map station coordinate array
  xor rcx,rcx
  mov ecx,dword ptr [rdi]                        //Read coordinate-z
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+58],ecx                     //Write coordinate-z for myself entity sever sync
  mov dword ptr [rdi+E8],ecx                     //Write coordinate-z for myself entity
  xor rdi,rdi
  xor rcx,rcx

  pop rcx
  pop rdi

  jmp End_AllTpLogic
SpringTP:
  cmp byte ptr [PosFuncStateList+1A],FF          //Judge TP state is wait TP
  je End_AllTpLogic
  cmp byte ptr [PosFuncStateList+1A],00          //Judge the value &gt;= 0
  jl End_AllTpLogic
  cmp byte ptr [PosFuncStateList+1A],01          //Judge the value &lt;= 1
  ja End_AllTpLogic

  push rdi
  push rcx
  xor rcx,rcx
  xor rdi,rdi

  mov rdi,qword ptr [PosFuncStateList+24]        //Read springboard TP congif list pointer
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read hotkey
  imul ecx,0C
  add rdi,ecx                                    //Pointer to springboard coordinate
  xor rcx,rcx
  mov ecx,dword ptr [rdi]                        //Read springboard coordinate-x
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+50],ecx                     //Write springboard coordinate-x to myself entity coordinate-x of sever sync
  mov dword ptr [rdi+E0],ecx                     //Write springboard coordinate-x to myself entity coordinate-x
  xor rdi,rdi
  xor rcx,rcx

  mov rdi,qword ptr [PosFuncStateList+24]        //Read springboard TP congif list pointer
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read hotkey
  imul ecx,0C
  add rdi,ecx                                    //Pointer to springboard coordinate
  xor rcx,rcx
  mov ecx,dword ptr [rdi+04]                     //Read springboard coordinate-y
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+54],ecx                     //Write springboard coordinate-x to myself entity coordinate-y of sever sync
  mov dword ptr [rdi+E4],ecx                     //Write springboard coordinate-x to myself entity coordinate-y
  xor rdi,rdi
  xor rcx,rcx

  mov rdi,qword ptr [PosFuncStateList+24]        //Read springboard TP congif list pointer
  movzx ecx,byte ptr [PosFuncStateList+1A]       //Read hotkey
  imul ecx,0C
  add rdi,ecx                                    //Pointer to springboard coordinate
  xor rcx,rcx
  mov ecx,dword ptr [rdi+08]                     //Read springboard coordinate-z
  xor rdi,rdi
  mov rdi,qword ptr [PosFuncStateList+11]        //Read myself entity object pointer
  mov dword ptr [rdi+58],ecx                     //Write springboard coordinate-x to myself entity coordinate-z of sever sync
  mov dword ptr [rdi+E8],ecx                     //Write springboard coordinate-x to myself entity coordinate-z

  pop rcx
  pop rdi

  jmp End_AllTpLogic
End_AllTpLogic:
  mov byte ptr [PosFuncStateList+1A],FF          //Restor hotkey
ClientEntityCoordinateXSetOnHookCode:
  movsd [rbx+000000E0],xmm0
  jmp HookExit_ClientEntityPosSet_x

OriginalAsm_LocalPlayerEntityPosInfo_x:
  push rax
  xor rax,rax
  mov eax,dword ptr [rsi]
  mov dword ptr [PosFuncStateList+8],eax     //Get myself coordinate-x
  mov eax,dword ptr [rsi+08]
  mov dword ptr [PosFuncStateList+C],eax     //Get myself coordinate-z
  movsd [rbx+64],xmm0
  pop rax
  jmp HookExit_LocalPlayerEntityPosInfo_x

HookExit_ClientEntityPosSet_x:  //Hook exit.
  jmp HookReturn_ClientEntityPosSet_x

HookExit_LocalPlayerEntityPosInfo_x:  //Hook exit.
  jmp HookReturn_LocalPlayerEntityPosInfo_x

//Hook inject.
ClientEntityPosSet_x:
  jmp OriginalAsm_ClientEntityPosSet_x
  nop 3
HookReturn_ClientEntityPosSet_x:  //Return original code.

LocalPlayerEntityPosInfo_x:
