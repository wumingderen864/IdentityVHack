      <AssemblerScript>{
    Author:BinRev
    Game:Identity V
    Creation date:2025/8/11
    Script description: initialize position functions.
}

[ENABLE]
//Get hook entry address.
aobscanmodule(ClientEntityPosSet_x,neox_engine.dll,F2 ?? ?? 83 E0 ?? ?? ?? F2 ?? ?? 06 F2 ?? ?? 87 ?? ?? ?? ?? 8B 46 08) //Game coordinates-x set of client entity.
aobscanmodule(LocalPlayerEntityPosInfo_x,neox_engine.dll,F2 ?? ?? 43 64 ?? 4A ?? ?? ?? 49 70 ?? ?? 42 20)  //Local player coordinate-x data of the game client.

//Bind symbols to the hook entry.
registersymbol(ClientEntityPosSet_x)
registersymbol(LocalPlayerEntityPosInfo_x)

//Allocated the memory for hook code.
alloc(HookCode,4096,neox_engine.dll)

//Allocated the memory for functions state data list.
alloc(PosFuncStateList,1024)
{
======================== Position functions state list struct ========================
PosFuncStateList:
  +0 (8byte) -&gt; Pointer to map station tp coordinate array
  +8 (4byte) -&gt; Myself coordinate-x
  +C (4byte) -&gt; Myself coordinate-z
  +10 (1byte) -&gt; Auto get myself entity object (0:disable,1:enable)
  +11 (8byte) -&gt; Myself entity object pointer
  +19 (1byte) -&gt; TP hack tp mode select (0:disable,1:自定义坐标瞬移,2:地图交互点瞬移,3:板车瞬移)
  +1A (1byte) -&gt; TP state (FF:wait,0:TP of hotkey-B,1:TP of hotkey-N,2:TP of hotkey-M,3:TP of hotkey-,,4:TP of hotkey-.,5:TP of hotkey-J,6:TP of hotkey-K,7:TP of hotkey-P)
  +1B (8byte) -&gt; Pointer to custom coordinate TP config list
  +23 (1byte) -&gt; Record the current coordinates for hotkey TP functions(FF:No recording,0:Recording coordinate of hotkey-B,1:Recording coordinate of hotkey-N,2:Recording coordinate of hotkey-M,
3:Recording coordinate of hotkey-,,4:Recording coordinate of hotkey-.,5:Recording coordinate of hotkey-J,6:Recording coordinate of hotkey-K,
7:Recording coordinate of hotkey-P,8:Recording coordinate of springboard_a,9:Recording coordinate of springboard_b)
  +24 (8byte) -&gt; Pointer to springboard TP config list.
  +2C (1byte) -&gt; Map select for map station tp. (0:联合狩猎_里奥的回忆,1:联合狩猎_湖景村,2:联合狩猎_月亮河公园,3:联合狩猎_永眠镇,4:匹配排位_月亮河公园,5:匹配排位_赛马场,
6:匹配排位_闪金石窟,7:匹配排位_不归林,8:匹配排位_圣心医院,9:匹配排位_军工厂,A:匹配排位_湖景村,B:匹配排位_永眠镇,C:匹配排位_里奥的回忆,D:模仿者_闪金石窟,E:噩梦逐影_闪金石窟)
  +2D (1byte) -&gt; Perfectly get myself entity object pointer (0:disable,1:enable)
======================================================================================
}

