      <AssemblerScript>{ Game   : dwrg.exe
  Version: 
  Date   : 2025-04-09
  Author : KernelHook
}

[ENABLE]
//================= 申请内存&amp;注册自定义符号 =================
aobscanmodule(SetClientPlayerPos_x,neox_engine.dll,F2 0F 11 83 E0 00 00 00 8B)  // 获取计算玩家对象x轴坐标共用代码地址
alloc(newmem,$1000,SetClientPlayerPos_x)              // Hook代码
label(return)
label(exit)
label(originalCodeLogic)  // 计算客户端玩家x轴数据原代码逻辑换
label(lockThisPlayerPos)  // Hook锁定此玩家到指定位置
label(trackObjPos)  // 绑定跟踪对象位置

alloc(thisPlayerPosXaddress,8)  // 获取位置对象玩家x轴地址
registersymbol(thisPlayerPosXaddress)

alloc(thisPlayerObjPtr,8)  // 此玩家对象指针
registersymbol(thisPlayerObjPtr)

alloc(posFuncStateDataArray,256)  // 玩家位置相关功能状态数据数组
registersymbol(posFuncStateDataArray)
{
玩家位置相关功能状态数据结构：
posFuncStateDataArray+0：Hook锁死坐标开关 bool 1byte 0/1
posFuncStateDataArray+1：通过目标玩家x轴地址强制使此玩家跟踪绑定到目标玩家位置开关 bool 1byte 0/1
posFuncStateDataArray+2：跟踪目标玩家x轴地址 long 8byte address
posFuncStateDataArray+A：指定此玩家坐标x float 4byte
posFuncStateDataArray+E：指定此玩家坐标y float 4byte
posFuncStateDataArray+12：指定此玩家坐标z float 4byte
}

//================= Hook代码 =================
newmem:
  push rax
  xor rax,rax
  lea rax,[rbx+E0]
  cmp qword ptr [thisPlayerPosXaddress],rax  // 比较当前计算x轴坐标的玩家是否为需获取的玩家的x轴地址
  jne originalCodeLogic
  mov [thisPlayerObjPtr],rbx
  cmp byte ptr [posFuncStateDataArray+0],01
  je lockThisPlayerPos
  cmp byte ptr [posFuncStateDataArray+1],01
  je trackObjPos
  jne originalCodeLogic
lockThisPlayerPos:
  push rcx
  xor rcx,rcx
  mov ecx,dword ptr [posFuncStateDataArray+A]
  mov dword ptr [rbx+E0],ecx
  mov dword ptr [rbx+50],ecx
  mov ecx,dword ptr [posFuncStateDataArray+E]
  mov dword ptr [rbx+E4],ecx
  mov dword ptr [rbx+54],ecx
  mov ecx,dword ptr [posFuncStateDataArray+12]
  mov dword ptr [rbx+E8],ecx
  mov dword ptr [rbx+58],ecx
  pop rcx
  jmp exit
trackObjPos:
  push rcx
  xor rcx,rcx
  xor rax,rax
  mov rax,[posFuncStateDataArray+2]
  sub rax,E0
  mov ecx,dword ptr [rax+E0]
  mov dword ptr [rbx+E0],ecx
  mov dword ptr [rbx+50],ecx
  mov ecx,dword ptr [rax+E4]
  mov dword ptr [rbx+E4],ecx
  mov dword ptr [rbx+54],ecx
  mov ecx,dword ptr [rax+E8]
  mov dword ptr [rbx+E8],ecx
  mov dword ptr [rbx+58],ecx
  pop rcx
  jmp exit

originalCodeLogic:
  movsd [rbx+000000E0],xmm0
exit:
  pop rax
  jmp return


//================= Hook入口 =================
SetClientPlayerPos_x:  // 内存注入地址
  jmp newmem
  nop 3
//================= Hook出口 =================
return:
registersymbol(SetClientPlayerPos_x)

[DISABLE]
//================= 还原代码 =================
SetClientPlayerPos_x:
  db F2 0F 11 83 E0 00 00 00

//================= 释放内存&amp;注销自定义符号 =================
unregistersymbol(SetClientPlayerPos_x)
dealloc(newmem)

dealloc(thisPlayerPosXaddress,8)
unregistersymbol(thisPlayerPosXaddress)

dealloc(thisPlayerObjPtr)
unregistersymbol(thisPlayerObjPtr)

dealloc(posFuncStateDataArray)
unregistersymbol(posFuncStateDataArray)



