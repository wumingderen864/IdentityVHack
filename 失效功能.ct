  mov edx,dword ptr [rbx+E0]
  cmp dword ptr [PosFuncStateList+08],edx    //Judge the x-axis
  pop rdx
  jne End_AutoGetMyselfObjIsDisable
  push rdx
  xor rdx,rdx
  mov edx,dword ptr [rbx+E8]
  cmp dword ptr [PosFuncStateList+0C],edx    //Judge the z-axis
  pop rdx
