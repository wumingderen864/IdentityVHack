//Allocated the memory for custom coordinate TP config list.
alloc(CustomCoorTPCfgList,256)
{
===================== Custom coordinate TP config list struct ========================
CustomCoorTPCfgList:
  +0*D -&gt; Hotkey_B:
    +0 -&gt; This TP hotkey is enable? (0:disable,1:enable)
    +1+0*4 -&gt; x
    +1+1*4 -&gt; y
    +1+2*4 -&gt; z
  +1*D -&gt; Hotkey_N:
    +0 -&gt; The TP hotkey is enable? (0:disable,1:enable)
    +1+0*4 -&gt; x
    +1+1*4 -&gt; y
    +1+2*4 -&gt; z
  ...
======================================================================================
}

//Initialize custom coordinate TP config list.
CustomCoorTPCfgList+0*D:       //Hotkey:B
  db 01
CustomCoorTPCfgList+1*D:       //Hotkey:N
  db 01
CustomCoorTPCfgList+2*D:       //Hotkey:M
  db 01
CustomCoorTPCfgList+3*D:       //Hotkey:,
  db 01
CustomCoorTPCfgList+4*D:       //Hotkey:.
  db 01
CustomCoorTPCfgList+5*D:       //Hotkey:J
  db 01
CustomCoorTPCfgList+6*D:       //Hotkey:K
  db 01
CustomCoorTPCfgList+7*D:       //Hotkey:P
  db 01

//Bind symbols to the custom coordinate TP config list.
registersymbol(CustomCoorTPCfgList)

//Allocated the memory for springboard TP config list.
alloc(SpringBoardTPCfgList,32)
{
========================== Springboard TP config list struct ==========================
SpringBoardTPCfgList:
  +0*C -&gt; Springboard_a:
    +0 -&gt; x
    +4 -&gt; y
    +8 -&gt; z
  +1*C -&gt; Springboard_b:
    +0 -&gt; x
    +4 -&gt; y
    +8 -&gt; z
======================================================================================
}

