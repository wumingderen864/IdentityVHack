        <CheatEntry>
          <ID>9</ID>
          <Description>"脚本1"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(INJECT,neox_engine.dll,F2 0F 10 71 10 48 8B FA) // should be unique
alloc(newmem,$1000,INJECT)
registersymbol(qwq300)
alloc(qwq300,$10)

newmem:

  cmp [rcx+10],00000000
  jne return
  cmp [rcx+14],4072C000
  jne return

  push rax
  lea rax,[rcx+10]
  cmp rax,[qwq300]
  je code

  mov [qwq300],rax
  inc [qwq300+08] //计数调试

code:

  pop rax

return:
  movsd xmm6,[rcx+10]
  jmp INJECT+5

INJECT:
  jmp newmem
[DISABLE]
INJECT:
  db F2 0F 10 71 10
unregistersymbol(*)
dealloc(*)
</AssemblerScript>
